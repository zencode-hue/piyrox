// ============================================================
// PIYROX Market — Prisma Schema
// Digital Subscription Marketplace at piyrox.sbs
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ========================  ENUMS  ============================

enum Role {
  CUSTOMER
  ADMIN
}

enum Category {
  STREAMING
  AI_TOOLS
  SOFTWARE
  GAMING
  VPN
  EDUCATION
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  DELIVERED
  EXPIRED
  REVOKED
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  FAILED
  REFUNDED
  PARTIALLY_DELIVERED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum BalanceTxType {
  DEPOSIT
  PURCHASE
  REFUND
  ADMIN_CREDIT
  ADMIN_DEBIT
  AFFILIATE_PAYOUT
  PARTNER_PAYOUT
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PartnerAffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

// ========================  MODELS  ===========================

model User {
  id              String   @id @default(cuid())
  name            String?
  email           String   @unique
  emailVerified   DateTime?
  hashedPassword  String?
  image           String?
  role            Role     @default(CUSTOMER)

  // Balance system
  balance         Float    @default(0)

  // Ban / lockout
  isBanned        Boolean  @default(false)
  banReason       String?
  bannedAt        DateTime?
  failedLogins    Int      @default(0)
  lockedUntil     DateTime?
  lastFailedLogin DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  orders            Order[]
  reviews           Review[]
  sessions          Session[]
  loginAttempts     LoginAttempt[]
  balanceTransactions BalanceTransaction[]
  affiliateProfile  Affiliate?
  discountUsages    DiscountUsage[]

  @@index([email])
  @@index([role])
  @@index([isBanned])
  @@map("users")
}

model Product {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String    @db.Text
  shortDesc   String?   @db.VarChar(300)
  imageUrl    String?
  category    Category
  basePrice   Float
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  avgRating   Float     @default(0)
  totalReviews Int      @default(0)
  stockCount  Int       @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Delivery instructions shown post-purchase
  deliveryInfo    String?  @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  variants       ProductVariant[]
  inventoryItems InventoryItem[]
  reviews        Review[]
  orderItems     Order[]       @relation("OrderProduct")

  @@index([slug])
  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
  @@index([basePrice])
  @@index([avgRating])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  name        String   // e.g. "1 Month", "3 Months", "1 Year"
  price       Float
  duration    String?  // e.g. "30 days", "90 days"
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  inventoryItems InventoryItem[]
  orders         Order[]        @relation("OrderVariant")

  @@index([productId])
  @@index([isActive])
  @@map("product_variants")
}

model InventoryItem {
  id            String          @id @default(cuid())
  productId     String
  variantId     String?
  encryptedData String          @db.Text  // AES-256-GCM encrypted credentials
  status        InventoryStatus @default(AVAILABLE)
  addedBy       String?         // admin who added
  deliveredTo   String?         // orderId it was delivered to
  deliveredAt   DateTime?
  expiresAt     DateTime?
  notes         String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([status])
  @@index([productId, status])
  @@map("inventory_items")
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  guestEmail      String?     // for guest checkout
  productId       String
  variantId       String?
  quantity        Int         @default(1)
  unitPrice       Float
  totalPrice      Float
  status          OrderStatus @default(PENDING)

  // Discount
  discountCodeId  String?
  discountAmount  Float       @default(0)

  // Payment
  paymentProvider String?     // "stripe", "paystack", "flutterwave", "balance"
  paymentRef      String?     @unique
  paidAt          DateTime?

  // IP & metadata
  ipAddress       String?
  userAgent       String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  product         Product      @relation("OrderProduct", fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant? @relation("OrderVariant", fields: [variantId], references: [id], onDelete: SetNull)
  discountCode    DiscountCode?   @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  deliveryLogs    DeliveryLog[]

  @@index([userId])
  @@index([guestEmail])
  @@index([status])
  @@index([paymentRef])
  @@index([paymentProvider])
  @@index([createdAt])
  @@map("orders")
}

model DeliveryLog {
  id          String   @id @default(cuid())
  orderId     String
  content     String   @db.Text  // Delivered credentials (encrypted at rest)
  deliveredAt DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("delivery_logs")
}

model DiscountCode {
  id            String       @id @default(cuid())
  code          String       @unique
  type          DiscountType
  value         Float        // percentage (0-100) or fixed amount
  minOrderValue Float?
  maxUses       Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  validFrom     DateTime     @default(now())
  validUntil    DateTime?

  // Restrict to specific category or product
  categoryRestriction Category?
  productRestriction  String?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders        Order[]
  usages        DiscountUsage[]

  @@index([code])
  @@index([isActive])
  @@map("discount_codes")
}

model DiscountUsage {
  id             String   @id @default(cuid())
  discountCodeId String
  userId         String
  usedAt         DateTime @default(now())

  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discountCodeId, userId])
  @@map("discount_usages")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int      // 1-5
  comment   String?  @db.Text
  isVisible Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
  @@map("reviews")
}

model Affiliate {
  id             String  @id @default(cuid())
  userId         String  @unique
  code           String  @unique
  commissionRate Float   @default(10) // percentage
  totalEarnings  Float   @default(0)
  totalPaid      Float   @default(0)
  isActive       Boolean @default(true)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals      Referral[]

  @@index([code])
  @@index([isActive])
  @@map("affiliates")
}

model Referral {
  id          String   @id @default(cuid())
  affiliateId String
  orderId     String?
  commission  Float    @default(0)
  ipAddress   String?

  createdAt   DateTime @default(now())

  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@map("referrals")
}

model WebhookLog {
  id        String   @id @default(cuid())
  provider  String   // "stripe", "paystack", etc.
  eventType String
  payload   String   @db.Text
  status    String   @default("received") // received, processed, failed
  error     String?  @db.Text

  createdAt DateTime @default(now())

  @@index([provider])
  @@index([eventType])
  @@index([createdAt])
  @@map("webhook_logs")
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String   // e.g. "product.create", "order.refund"
  target    String?  // target entity id
  details   String?  @db.Text
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ipAddress String?
  userAgent String?
  success   Boolean
  reason    String?  // "invalid_password", "locked_out", "banned"

  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_attempts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model BalanceTransaction {
  id          String       @id @default(cuid())
  userId      String
  type        BalanceTxType
  amount      Float        // positive = credit, negative = debit
  balance     Float        // balance after transaction
  description String?
  reference   String?      // orderId, paymentRef, etc.

  createdAt   DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("balance_transactions")
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  excerpt     String?  @db.VarChar(500)
  coverImage  String?
  authorId    String
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  tags        String[] // PostgreSQL array

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([publishedAt])
  @@map("blog_posts")
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  ipAddress String?
  userAgent String?
  referrer  String?
  country   String?

  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@map("page_views")
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  group String @default("general") // "general", "payment", "email", "seo"

  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
  @@map("site_settings")
}

model StaffMember {
  id             String      @id @default(cuid())
  name           String
  email          String      @unique
  hashedPassword String
  role           String      @default("support") // "support", "manager"
  permissions    String[]    // PostgreSQL array of permission strings
  status         StaffStatus @default(ACTIVE)
  lastLoginAt    DateTime?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([email])
  @@index([status])
  @@map("staff_members")
}

model PartnerAffiliate {
  id              String                 @id @default(cuid())
  name            String
  email           String                 @unique
  company         String?
  website         String?
  code            String                 @unique
  commissionRate  Float                  @default(15)
  status          PartnerAffiliateStatus @default(PENDING)
  totalEarnings   Float                  @default(0)
  totalPaid       Float                  @default(0)
  notes           String?                @db.Text

  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  referrals       PartnerReferral[]
  payoutRequests  PartnerPayoutRequest[]

  @@index([code])
  @@index([email])
  @@index([status])
  @@map("partner_affiliates")
}

model PartnerReferral {
  id                String   @id @default(cuid())
  partnerAffiliateId String
  orderId           String?
  commission        Float    @default(0)
  ipAddress         String?
  convertedAt       DateTime?

  createdAt         DateTime @default(now())

  partnerAffiliate  PartnerAffiliate @relation(fields: [partnerAffiliateId], references: [id], onDelete: Cascade)

  @@index([partnerAffiliateId])
  @@map("partner_referrals")
}

model PartnerPayoutRequest {
  id                String       @id @default(cuid())
  partnerAffiliateId String
  amount            Float
  status            PayoutStatus @default(PENDING)
  paymentMethod     String?      // "bank_transfer", "crypto", "paypal"
  paymentDetails    String?      @db.Text
  processedAt       DateTime?
  processedBy       String?      // admin id
  notes             String?      @db.Text

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  partnerAffiliate  PartnerAffiliate @relation(fields: [partnerAffiliateId], references: [id], onDelete: Cascade)

  @@index([partnerAffiliateId])
  @@index([status])
  @@map("partner_payout_requests")
}

model SocialBlast {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  platforms   String[] // e.g. ["twitter", "telegram", "discord"]
  scheduledAt DateTime?
  sentAt      DateTime?
  status      String   @default("draft") // "draft", "scheduled", "sent", "failed"
  sentBy      String?
  error       String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@map("social_blasts")
}
